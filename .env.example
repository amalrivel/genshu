# Server-side PostgreSQL connection only. Never use a NEXT_PUBLIC_ prefix.
# Local development: postgresql://genshu:genshu@127.0.0.1:5432/genshu
# Supabase Vercel runtime: use the session/transaction pooler URL appropriate to the runtime.
POSTGRES_URL=

# Supabase Auth (staff login). Publishable key is safe for browser use; never place a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
