generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum ActivityType {
  practice
  mock_exam
  exam
  assignment
}

// NOTE: Master labels/descriptions. IDs mirror ActivityType; the enum remains
// the allowed-value constraint. Navigation reads these master records.
model ActivityCategory {
  id          String @id @db.VarChar(191)
  title       String @db.VarChar(255)
  description String @db.Text

  @@map("activity_categories")
}

model Activity {
  id          String             @id @db.VarChar(191)
  title       String             @db.VarChar(255)
  description String             @db.Text
  type        ActivityType
  questions   ActivityQuestion[]

  @@index([type])
  @@map("activities")
}

model ActivityQuestion {
  activityId    String   @map("activity_id") @db.VarChar(191)
  id            String   @db.VarChar(191)
  question      String   @db.Text
  correctAnswer Boolean  @map("correct_answer")
  position      Int      @db.UnsignedInt
  activity      Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@id([activityId, id])
  @@unique([activityId, position])
  @@map("activity_questions")
}

// NOTE: Better Auth owns identity/session data; LMS access rules stay in application code.
model User {
  id            String    @id @db.VarChar(191)
  name          String
  email         String    @unique @db.VarChar(191)
  emailVerified Boolean   @default(false)
  image         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id @db.VarChar(191)
  expiresAt DateTime
  token     String   @unique @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?  @db.Text
  userId    String   @db.VarChar(191)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @db.VarChar(191)
  accountId             String    @db.VarChar(191)
  providerId            String    @db.VarChar(191)
  userId                String    @db.VarChar(191)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @db.VarChar(191)
  identifier String   @db.VarChar(191)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

