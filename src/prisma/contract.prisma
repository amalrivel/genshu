// use prisma-8
// NOTE: Current behavior: starter User/Post models, not the learning/auth domain.
// TODO: Model managed accounts, published content, and saved practice attempts;
// review migration/data effects. See docs/developer-guide.md, Data integration.

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  posts     Post[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
