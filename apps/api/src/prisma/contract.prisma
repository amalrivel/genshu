// use prisma-next

enum UserRole {
  @@type("pg/text@1")
  Participant = "Participant"
  Admin       = "Admin"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  role         UserRole @default(Participant)
  passwordHash String?
  isActive     Boolean  @default(false)
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt TimestamptzString
  revokedAt TimestamptzString?
  createdAt TimestamptzString @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invitation {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt TimestamptzString
  consumedAt TimestamptzString?
  revokedAt TimestamptzString?
  createdAt TimestamptzString @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt TimestamptzString
  consumedAt TimestamptzString?
  revokedAt TimestamptzString?
  createdAt TimestamptzString @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Topic {
  id        Int @id @default(autoincrement())
  title     String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Material {
  id      Int @id @default(autoincrement())
  title   String
  content String
  topicId Int
  topic   Topic @relation(fields: [topicId], references: [id])
}

model Question {
  id                    Int      @id @default(autoincrement())
  japaneseText          String
  indonesianTranslation String
  furigana              String?
  correctAnswer         Boolean
  japaneseExplanation   String
  indonesianExplanation String
  topicId               Int
  topic                 Topic    @relation(fields: [topicId], references: [id])
  createdAt             TimestamptzString @default(now())
  updatedAt             temporal.updatedAtString()
}

model PracticeSet {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model PracticeSetQuestion {
  id            Int @id @default(autoincrement())
  practiceSetId Int
  questionId    Int
  position      Int
  practiceSet   PracticeSet @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)
  question      Question    @relation(fields: [questionId], references: [id])

  @@unique([practiceSetId, questionId])
  @@unique([practiceSetId, position])
}
