// use prisma-next

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Topic {
  id        Int @id @default(autoincrement())
  title     String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Material {
  id      Int @id @default(autoincrement())
  title   String
  content String
  topicId Int
  topic   Topic @relation(fields: [topicId], references: [id])
}

model Question {
  id                    Int      @id @default(autoincrement())
  japaneseText          String
  indonesianTranslation String
  furigana              String?
  correctAnswer         Boolean
  japaneseExplanation   String
  indonesianExplanation String
  topicId               Int
  topic                 Topic    @relation(fields: [topicId], references: [id])
  createdAt             TimestamptzString @default(now())
  updatedAt             temporal.updatedAtString()
}

model PracticeSet {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model PracticeSetQuestion {
  id            Int @id @default(autoincrement())
  practiceSetId Int
  questionId    Int
  position      Int
  practiceSet   PracticeSet @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)
  question      Question    @relation(fields: [questionId], references: [id])

  @@unique([practiceSetId, questionId])
  @@unique([practiceSetId, position])
}
