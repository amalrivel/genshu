# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Used only by `pnpm --filter api run bootstrap:admin`; do not commit real values.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-password-of-at-least-12-characters"
ADMIN_NAME="Genshu Admin"

# Browser origin for invitation/reset URLs in production. Local requests use their Origin header.
WEB_URL="http://localhost:5173"
